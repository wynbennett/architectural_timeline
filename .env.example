# Credentials for the generator and chat. Pick ONE:
#   (a) OAuth, no key to manage:   brew install anthropics/tap/ant && ant auth login
#       then leave ANTHROPIC_API_KEY unset (an exported key always overrides the profile).
#       Optional: ANTHROPIC_PROFILE=<name> to pick a named profile.
#   (b) API key:
# ANTHROPIC_API_KEY=sk-ant-...

# sqlite for local dev; on Vercel set a postgres:// URL (Vercel Postgres / Neon)
DATABASE_URL=sqlite:///./data/dev.db

# local   = git clone + background thread (use this on your machine)
# chunked = GitHub tarball + one time-boxed step per HTTP call, driven by the browser (Vercel)
# off     = view only
GENERATION_MODE=local
# chunked mode: seconds of work per step; keep under the function's maxDuration
STEP_BUDGET_S=150

# where repos are cloned locally
REPO_CACHE_DIR=./data/repos

# model for generation and chat (default claude-sonnet-5; claude-opus-5 for higher quality)
ARCH_MODEL=claude-sonnet-5

# local = read file contents via git from the clone; github = raw.githubusercontent.com
FILE_SOURCE=local
